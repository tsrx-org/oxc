{
  // Comments and trailing commas are JSONC, as tsconfig allows.
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "custom-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": { "custom-jsx/jsx-runtime": ["../shared/jsx-runtime.d.ts"] },
    "strict": true,
    "target": "ESNext",
    "types": [],
  },
  "include": ["src"],
}
