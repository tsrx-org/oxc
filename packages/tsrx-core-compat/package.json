{
  "name": "@tsrx/oxc-core-compat",
  "version": "0.8.0",
  "description": "A dependency-light @tsrx/core parser facade powered by @tsrx/oxc/parser",
  "keywords": [
    "oxc",
    "parser",
    "tsrx"
  ],
  "homepage": "https://compiled.run/oxc-tsrx",
  "bugs": {
    "url": "https://github.com/tsrx-org/oxc/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsrx-org/oxc.git",
    "directory": "packages/tsrx-core-compat"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts"
    },
    "./types/estree": {
      "types": "./dist/types/estree.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": false,
  "dependencies": {
    "@oxc-project/types": "0.140.0",
    "@tsrx/oxc": "0.8.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
